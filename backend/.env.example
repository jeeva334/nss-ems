# Copy to .env for local development. NEVER commit a real .env.
APP_ENV=development            # development | test | production
DATABASE_URL=postgresql+psycopg://manpower:devpassword@localhost:5432/manpower_dev
TEST_DATABASE_URL=postgresql+psycopg://manpower:devpassword@localhost:5432/manpower_test
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-48
CORS_ORIGINS=http://localhost:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
LOG_LEVEL=INFO
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60
# COOKIE_SECURE=true            # defaults to true when APP_ENV=production
COOKIE_SAMESITE=lax             # "none" requires COOKIE_SECURE=true (cross-site frontend)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
